# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api
WEB_ORIGIN=http://localhost:3000
# Set on production so the refresh cookie is scoped to your domain.
# COOKIE_DOMAIN=.example.com

# ─── Data stores ────────────────────────────────────────────────────────────
# Both are addressed only through these URLs, so moving them onto their own
# hosts when you add a second app server is a config change, not a code change.
DATABASE_URL=postgresql://ott:ott@localhost:5432/ott?schema=public
REDIS_URL=redis://localhost:6379

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-me-with-a-different-32-plus-char-secret
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

# ─── Flussonic ──────────────────────────────────────────────────────────────
# Origin only — no trailing slash, no stream name, no /index.m3u8. Stream names
# live in the database (Channel.streamPath / Title.streamPath / Episode.streamPath)
# and are edited in the admin UI. URLs are built as <base>/<streamPath>/index.m3u8.
FLUSSONIC_BASE_URL=https://stream.example.com

# Securelink signing key, copied verbatim from Flussonic: stream → Auth tab →
# "Securelink auth key" (Authentication type: securelink). Keep any
# ?no_check_ip=true suffix — it is parsed out, not treated as key material.
# This key never appears in a URL; tokens are derived from it per session as
# sha1(stream + ip + starttime + endtime + key + salt).
FLUSSONIC_SECURELINK_KEY=

# Where tokens are attached: live | all | none. Many deployments authenticate
# live channels only and serve VOD openly; signing a URL the server does not
# expect to be signed gets it rejected.
FLUSSONIC_TOKEN_SCOPE=live

# Bind tokens to the viewer's IP. Ignored when the key carries ?no_check_ip=true.
# Set false for audiences on mobile networks that rotate IPs mid-session.
FLUSSONIC_BIND_IP=true

# TTLs must exceed the longest expected sitting; the player re-mints on 403.
PLAYBACK_TOKEN_TTL_SEC=14400
LIVE_TOKEN_TTL_SEC=28800

# IPs allowed to call GET /api/playback/flussonic-auth. Set this to your
# Flussonic server's IP in production. Empty means "allow any caller".
FLUSSONIC_AUTH_IP_ALLOWLIST=

# ─── Google sign-in ─────────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials — an OAuth 2.0 Client ID
# of type "Web application". Only the client id is needed server-side (id
# token audience check); no client secret is required for this flow. Empty
# disables Google sign-in without affecting password auth.
GOOGLE_CLIENT_ID=

# ─── TMDB (metadata import) ─────────────────────────────────────────────────
# https://www.themoviedb.org/settings/api — accepts either a v4 read access
# token (JWT, sent as a bearer header) or a v3 API key (query parameter).
# Empty disables the import feature without affecting anything else.
TMDB_API_KEY=
TMDB_LANGUAGE=en-US

# ─── Artwork storage ────────────────────────────────────────────────────────
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
PUBLIC_ASSET_BASE_URL=http://localhost:4000/uploads
# Switch STORAGE_DRIVER to s3 and fill these in when you add a second app server.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Rate limiting ──────────────────────────────────────────────────────────
THROTTLE_TTL_SEC=60
THROTTLE_LIMIT=300

# ─── Seed script ────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@ott.local
SEED_ADMIN_PASSWORD=changeme123
# Stream name the sample VOD titles point at.
SEED_VOD_STREAM=vod/sample.mp4

# ─── Web app (Next.js) ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Shown as the page title and the login screen's wordmark. Defaults to
# "Streamly" if unset.
NEXT_PUBLIC_BRAND_NAME=Streamly
# Same Google OAuth Client ID as GOOGLE_CLIENT_ID above — safe to expose to
# the browser by design (Google Identity Services checks the origin, not
# secrecy of the client id). Empty hides the "Continue with Google" button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
